PORT=5000
ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
# Set MONGODB_URI for durable production storage. Leave it unset for local
# development with the file-backed store.
# MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=licenses
# Optional for local file-backed storage; use a durable volume in deployments.
# DATA_FILE=licenses.json
